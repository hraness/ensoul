{
  "name": "@hraness/soulscrape",
  "version": "0.4.0",
  "description": "Turn an authorized corpus into a dated, evidence-calibrated working model of a person, with an asking protocol, instruction-bound web research, and explicit privacy and proxy boundaries.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/soulscrape.git"
  },
  "homepage": "https://soulscrape.com",
  "bugs": {
    "url": "https://github.com/hraness/soulscrape/issues"
  },
  "keywords": [
    "agent-skill",
    "agent-skills",
    "ai-agents",
    "coding-agents",
    "person-model",
    "personal-operating-manual",
    "digital-twin",
    "evidence",
    "privacy",
    "codex",
    "claude-code",
    "cursor",
    "soulscrape",
    "web-research"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "VERSION",
    "schema",
    "skills/soulscrape/agents",
    "skills/soulscrape/LICENSE",
    "skills/soulscrape/NOTICE.md",
    "skills/soulscrape/references",
    "skills/soulscrape/scripts/*.ts",
    "skills/soulscrape/SKILL.md"
  ],
  "scripts": {
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:runtime-policy": "bun scripts/check-runtime-policy.ts",
    "check:schema": "bun -e 'JSON.parse(await Bun.file(\"schema/ensoul-source-packet-v1.schema.json\").text())'",
    "check:package": "bun scripts/check-package.ts",
    "check": "bun run typecheck && bun run test && bun run check:runtime-policy && bun run check:schema && bun run check:package",
    "check:site": "cd site && bun install --frozen-lockfile --ignore-scripts && bun run check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
