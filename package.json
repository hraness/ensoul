{
  "name": "@hraness/ensoul",
  "version": "0.3.0",
  "description": "A privacy-bounded Agent Skill for dated, evidence-calibrated whole-person working models.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "contentPolicy": {
    "class": "dual-use"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/ensoul.git"
  },
  "homepage": "https://skills.sh/hraness/ensoul/ensoul",
  "bugs": {
    "url": "https://github.com/hraness/ensoul/issues"
  },
  "keywords": [
    "agent-skill",
    "agent-skills",
    "ai-agents",
    "coding-agents",
    "person-model",
    "personal-operating-manual",
    "digital-twin",
    "evidence",
    "privacy",
    "codex",
    "claude-code",
    "cursor"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "VERSION",
    "schema",
    "skills/ensoul/agents",
    "skills/ensoul/LICENSE",
    "skills/ensoul/NOTICE.md",
    "skills/ensoul/references",
    "skills/ensoul/scripts/*.ts",
    "skills/ensoul/SKILL.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:runtime-policy": "bun scripts/check-runtime-policy.ts",
    "check:schema": "bun -e 'JSON.parse(await Bun.file(\"schema/ensoul-source-packet-v1.schema.json\").text())'",
    "check:package": "bun scripts/check-package.ts",
    "check": "bun run typecheck && bun run test && bun run check:runtime-policy && bun run check:schema && bun run check:package"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
